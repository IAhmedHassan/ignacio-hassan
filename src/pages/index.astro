---
const rawBase = import.meta.env.BASE_URL || "/";
const baseUrl = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const defaultTarget = `${baseUrl}es/analista-funcional/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${defaultTarget}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirigiendo a CV de Ignacio Ahmed Hassan...</title>
    <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
    <script define:vars={{ baseUrl, defaultTarget }}>
      try {
        const stored = localStorage.getItem("preferred-lang");
        const browser = (navigator.languages?.[0] || navigator.language || "es").toLowerCase();
        const lang = stored || (browser.startsWith("en") ? "en" : "es");
        const target = `${baseUrl}${lang}/analista-funcional/`;
        window.location.replace(target);
      } catch (e) {
        window.location.replace(defaultTarget);
      }
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        text-align: center;
        padding: 1rem;
      }
      a {
        color: #60a5fa;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div>
      <p>Redirigiendo al perfil profesional...</p>
      <p><a href={defaultTarget}>Haz clic aquí si no eres redirigido automáticamente</a></p>
    </div>
  </body>
</html>
