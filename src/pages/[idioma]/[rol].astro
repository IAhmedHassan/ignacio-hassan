  <main class="document-container">
    <article class="cv-card">
      <!-- PERFIL PROFESIONAL / INTRODUCCIÓN -->
      <section class="cv-profile profile-content">
        <h1 class="profile-name">{common.name}</h1>
        <p class="profile-title">{roleContent.title}</p>
        <p class="profile-bio">{roleContent.bio}</p>

        <p class="profile-details content-details">
          <span class="detail-item">
            {common.location}
          </span>
          <span class="detail-separator" aria-hidden="true">&bull;</span>
          <a class="detail-item" href={`mailto:${common.email}`}>
            ✉️ {common.email}
          </a>
        </p>

        <div class="profile-actions">
          <Social />

          <div class="cv-download-dropdown">
            <button
              type="button"
              class="btn-download-cv btn-download-trigger"
              id="download-trigger"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>{common.downloadCV}</span>
              <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <div class="download-menu" id="download-menu" role="menu">
              <button
                type="button"
                class="download-option"
                data-print-format="visual"
                role="menuitem"
              >
                {common.downloadCVNormal}
              </button>

              <button
                type="button"
                class="download-option"
                data-print-format="ats"
                role="menuitem"
              >
                {common.downloadCVATS}
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- CUERPO DEL CV -->
      <div class="cv-body">
        <!-- EXPERIENCIA LABORAL -->
        <section class="cv-section cv-section--experience">
          <h2 class="section-title">{common.workExperienceTitle}</h2>
          <div class="timeline">
            {common.jobs.map((job) => (
              <div class="timeline-item">
                <div class="item-header">
                  <h3 class="item-title">{job.role}</h3>
                  <span class="item-period">{job.period}</span>
                </div>
                <div class="item-subtitle">{job.company}</div>
                <ul class="item-bullets">
                  {job.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- EDUCACIÓN Y CERTIFICACIONES -->
        <div class="cv-side cv-side-content">
          <section class="cv-section">
            <h2 class="section-title">{common.educationTitle}</h2>
            <div class="education-grid">
              {common.education.map((edu) => (
                <div class="education-item">
                  <div class="education-degree">{edu.degree}</div>
                  <div class="education-institution">{edu.institution}</div>
                  <span class="education-status">{edu.status}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="cv-section">
            <h2 class="section-title">{common.certificationsTitle}</h2>
            <ul class="certifications-list">
              {common.certifications.map((cert) => (
                <li>{cert}</li>
              ))}
            </ul>
          </section>
        </div>

        <!-- PROYECTOS ACADÉMICOS -->
        <section class="cv-section cv-section--projects">
          <h2 class="section-title">{common.academicProjectsTitle}</h2>
          <div class="projects-grid">
            {roleContent.projects.map((project) => (
              <article class="project-card">
                <div class="project-head">
                  <h3 class="project-name">{project.name}</h3>
                  <span class="project-period">{project.period}</span>
                </div>
                <div class="project-context">{project.context}</div>
                <div class="project-role">{project.roleInTeam}</div>
                <p class="project-desc">{project.description}</p>
                <div class="project-stack">
                  {project.stack.map((tech, index) => (
                    <>
                      <span class="skill-tag">{tech}</span>
                      {index < project.stack.length - 1 && (
                        <span class="pill-separator" aria-hidden="true"> • </span>
                      )}
                    </>
                  ))}
                </div>
                <a
                  class="project-link"
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {common.repoLinkLabel}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </article>
            ))}
          </div>
        </section>

        <!-- COMPETENCIAS Y HABILIDADES TÉCNICAS -->
        <section class="cv-section cv-section--skills">
          <h2 class="section-title">{common.skillsTitle}</h2>
          <div class="skills-highlight">
            {roleContent.keySkills.map((skill, index) => (
              <>
                <span class="skill-pill skill-pill--key">{skill}</span>
                {index < roleContent.keySkills.length - 1 && (
                  <span class="pill-separator" aria-hidden="true"> • </span>
                )}
              </>
            ))}
          </div>
          {roleContent.secondarySkills?.length > 0 && (
            <p class="skills-secondary">
              {idioma === "es" ? "También:" : "Also:"} {roleContent.secondarySkills.join(", ")}
            </p>
          )}
        </section>
      </div>
    </article>

    <footer class="cv-footer">
      <p>{common.name} &bull; La Plata, Buenos Aires, Argentina</p>
    </footer>
  </main>

  <!-- SCRIPTS DE INTERACCIÓN (IDIOMA Y DESCARGA / IMPRESIÓN CV) -->
  <script define:vars={{ idioma, pdfName: roleContent.pdfName }}>
    // Guardar preferencia de idioma al visitar
    try {
      localStorage.setItem("preferred-lang", idioma);
    } catch (e) {
      // Ignorar si el almacenamiento local está restringido
    }

    // Manejo del menú desplegable de descarga e impresión (Visual vs ATS)
    const trigger = document.getElementById("download-trigger");
    const menu = document.getElementById("download-menu");
    const options = document.querySelectorAll("[data-print-format]");

    function toggleMenu(show) {
      if (!menu || !trigger) return;
      const willShow = show !== undefined ? show : !menu.classList.contains("is-open");
      menu.classList.toggle("is-open", willShow);
      trigger.setAttribute("aria-expanded", String(willShow));
    }

    if (trigger && menu) {
      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener("click", (e) => {
        if (!trigger.contains(e.target) && !menu.contains(e.target)) {
          toggleMenu(false);
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          toggleMenu(false);
        }
      });

      options.forEach((btn) => {
        btn.addEventListener("click", () => {
          const format = btn.getAttribute("data-print-format");
          toggleMenu(false);
          descargarCV(format);
        });
      });
    }

    function descargarCV(format) {
      const originalTitle = document.title;
      
      if (format === "ats") {
        document.body.classList.add("ats-format");
        const cleanName = pdfName ? pdfName.replace(/\.pdf$/i, "") + "_ATS" : "CV_Ignacio_Hassan_ATS";
        document.title = cleanName;
      } else {
        document.body.classList.remove("ats-format");
        const cleanName = pdfName ? pdfName.replace(/\.pdf$/i, "") : "CV_Ignacio_Hassan";
        document.title = cleanName;
      }

      // Abre el diálogo de impresión / Guardar como PDF
      window.print();

      // Restaurar estado al cerrar el diálogo
      const cleanup = () => {
        document.body.classList.remove("ats-format");
        document.title = originalTitle;
      };

      window.addEventListener("afterprint", cleanup, { once: true });
      setTimeout(cleanup, 1500);
    }
  </script>
</Layout>
